{
  "name": "super-z-shop",
  "version": "1.0.0",
  "private": true,
  "description": "SUPER Z SHOP — Premium Everyday Essentials. Local-first e-commerce demo for Bangladesh.",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3000",
    "build": "node scripts/ensure-db.mjs && next build",
    "start": "next start -H 0.0.0.0 -p 3000",
    "lint": "tsc --noEmit",
    "db:reset": "node scripts/db-reset.mjs",
    "db:seed": "node scripts/seed.mjs",
    "db:verify": "node scripts/verify-db.mjs",
    "test": "node scripts/qa-test.mjs",
    "workbook": "python3 scripts/build_workbook.py",
    "db:ensure": "node scripts/ensure-db.mjs"
  },
  "dependencies": {
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.3"
  }
}
