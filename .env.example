# SUPER Z SHOP — Local demo environment
# Copy to .env.local (optional). All values have safe local defaults.

# Path to the SQLite database file (relative to project root)
DATABASE_PATH=db/super-z-shop.db

# Secret used to sign demo admin session cookies.
# CHANGE THIS for anything beyond a local demo.
ADMIN_SESSION_SECRET=superz-local-demo-secret-change-me

# Demo admin bootstrap credentials (created by `npm run db:reset`)
ADMIN_EMAIL=admin@superzshop.bd
ADMIN_PASSWORD=SuperZ@2026
